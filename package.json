{
  "name": "@oresoftware/f2e",
  "version": "0.3.0",
  "description": "Parse project-declared CLI flags into environment override maps.",
  "license": "MIT",
  "type": "module",
  "main": "./clients/nodejs/lib.cjs",
  "types": "./clients/nodejs/lib.ts",
  "bin": {
    "f2e": "./clients/nodejs/cli.mjs",
    "flags2env": "./clients/nodejs/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./clients/nodejs/lib.ts",
      "import": "./clients/nodejs/lib.mjs",
      "require": "./clients/nodejs/lib.cjs",
      "default": "./clients/nodejs/lib.mjs"
    },
    "./bun": {
      "types": "./clients/bun/lib.ts",
      "bun": "./clients/bun/lib.mjs",
      "import": "./clients/bun/lib.mjs",
      "require": "./clients/bun/lib.cjs",
      "default": "./clients/bun/lib.mjs"
    },
    "./deno": "./clients/deno/mod.ts",
    "./deno/lib.ts": "./clients/deno/lib.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "install": "cd clients/nodejs && node-gyp rebuild",
    "pack:audit": "node scripts/audit-npm-package.mjs",
    "pack:dry-run": "npm pack --dry-run",
    "release:audit": "node scripts/audit-release-matrix.mjs",
    "test:readme": "node scripts/test-readme-snippets.mjs",
    "lint:ores": "if [ -f .ores-lint/lint.sh ]; then sh .ores-lint/lint.sh; else echo 'ores-lint not installed'; fi",
    "prepublishOnly": "npm run lint:ores"
  },
  "files": [
    "LICENSE",
    "README.md",
    "clients/nodejs/addon.c",
    "clients/nodejs/binding.gyp",
    "clients/nodejs/cli.mjs",
    "clients/nodejs/lib.cjs",
    "clients/nodejs/lib.mjs",
    "clients/nodejs/lib.ts",
    "clients/bun/lib.cjs",
    "clients/bun/lib.mjs",
    "clients/bun/lib.ts",
    "clients/deno/lib.ts",
    "clients/deno/mod.ts",
    "src/parser.c",
    "src/parser.h"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flags-2-env/flags-2-env.git"
  },
  "keywords": [
    "cli",
    "env",
    "flags",
    "configuration"
  ],
  "engines": {
    "node": ">=20.17"
  },
  "dependencies": {
    "node-gyp": "^12.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  },
  "oresLint": {
    "note": "Declared, not installed. ores-lint resolves these from a global install - see .ores-lint/README.md",
    "requires": {
      "eslint": ">=9",
      "typescript-eslint": ">=8 (optional; without it .ts files are skipped)"
    },
    "install": "npm i -g eslint typescript-eslint"
  }
}
